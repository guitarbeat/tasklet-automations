{
  "name": "tasklet-automations",
  "private": true,
  "description": "Monorepo for Tasklet automation tooling — PR health dashboard, Jules rebase pipeline, and GitHub Actions workflows",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "tsc --noEmit",
    "format": "prettier --write '**/*.{ts,tsx,json,md,css}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,md,css}'"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
